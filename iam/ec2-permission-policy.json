{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetObjectUnderSiteOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3069/site/*"
    },
    {
      "Sid": "AllowListBucketWithSitePrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3069",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "site/"
        }
      }
    }
  ]
}
